# Normalize line endings to LF and let Git handle text/binary detection.
* text=auto eol=lf

# Source charset is UTF-8; editors should honor this via .editorconfig.
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.webmanifest text eol=lf

*.bat text eol=crlf
